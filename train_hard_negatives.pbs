#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_hardneg
#PBS -l walltime=08:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# Resume the retrieval checkpoint with its own R2 objective and ramp in the hard
# decoy loss. Requires cache/decoys/ from precompute_decoys.pbs.

module load frameworks
source /flare/NLDesignProtein/bryan/envs/filip-env/bin/activate
cd /flare/NLDesignProtein/bryan/FILIP-dev-space/mini-embed-filip

NNODES=$(wc -l < "$PBS_NODEFILE"); RANKS_PER_NODE=12
NRANKS=$(( NNODES * RANKS_PER_NODE ))           # 16*12 = 192 ranks, 12 groups of 16

export FILIP_MODELS_DIR=/flare/NLDesignProtein/bryan/FILIP-dev-space/models
# FILIP_DATA_CSV intentionally unset: this phase is cache-only (base cache +
# decoy cache + the retrieval run's splits.json). The CSV was only needed to
# build the decoys.
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export MASTER_ADDR=$(head -n1 "$PBS_NODEFILE"); export MASTER_PORT=29503
export OMP_NUM_THREADS=8
export CCL_PROCESS_LAUNCHER=pmix
export CCL_ATL_TRANSPORT=mpi
export FI_PROVIDER=cxi
export CCL_ZE_IPC_EXCHANGE=pidfd
export ONEAPI_DEVICE_SELECTOR="level_zero:gpu"

source ~/bin/slack_notify.sh
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"

# --align-aux-weight 0 / --r2-uniformity-weight 0 mirror train_retrieval.pbs:
# these MUST match what the resumed run finished with, or "resume with its
# existing objective" silently isn't.
#
# Decoy schedule: 5% of the run pure R2 (re-warm at the lower LR), then ramp the
# decoy weight to 0.5 over the next 35% and hold. Watch d_acc / val_decoy_acc
# rise while R@K holds; if R@K sags as the ramp tops out, lower --decoy-weight or
# switch to the bounded hinge (--decoy-margin 0.02).
mpiexec -n ${NRANKS} -ppn ${RANKS_PER_NODE} --cpu-bind depth -d 8 \
    python -m src.train_hard_negatives --device xpu \
        --resume checkpoints/retrieval/epoch20.pt \
        --cache-dir cache --decoy-cache-dir cache/decoys \
        --ckpt-dir checkpoints/hard_negatives \
        --batch-size 16 --group-size 16 --filip-chunk-rows 8 \
        --epochs 4 --lr 5e-5 --num-workers 4 \
        --align-aux-weight 0 --r2-uniformity-weight 0 \
        --decoy-weight 0.5 --decoy-start-frac 0.05 --decoy-ramp-frac 0.35 \
        --max-decoys 2

rc=$?
if [ $rc -eq 0 ]; then
    slack ":white_check_mark: DONE ${PBS_JOBID} ${PBS_JOBNAME}"
else
    slack ":x: FAILED (exit ${rc}) ${PBS_JOBID} ${PBS_JOBNAME}"
fi
exit $rc
