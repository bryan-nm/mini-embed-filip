#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_gen_set
#PBS -l walltime=01:00:00
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# Generate a set of proteins for a list of accessions (text -> protein).
#
# Reads ID_FILE (one primary_Accession per line, same format as inspect.pbs),
# pulls each accession's caption + true protein from the corpus, and emits
# NUM_OUTPUTS sequences per accession. Each sequence is the winner of an
# independent best-of-N round: N candidates sampled at TEMPERATURE/TOP_P,
# re-encoded, and scored by contrastive round-trip margin against the source
# caption (negatives from a panel of other captions).
#
# Single process on one tile: best-of-N already batches its N candidates, and the
# work is a handful of accessions, not a corpus sweep.
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

# PBS runs this from a spooled copy with $HOME as the working directory, so the
# cd MUST come before the source — see pbs_common.sh.
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./pbs_common.sh

# ===========================================================================
# Checkpoints and I/O
# ===========================================================================
RETRIEVAL_CKPT=checkpoints/retrieval/epoch50.pt
DECODER_CKPT=checkpoints/generation/text2protein_rl/step003800.pt
ID_FILE=protein_ids.txt                            # one primary_Accession per line
OUT=generated_out/generated_proteins.csv

# ===========================================================================
# Hyperparameters
# ===========================================================================
# WALL TIME BASIS: NUM_CANDIDATES x NUM_OUTPUTS x MAX_NEW_TOKENS per accession,
# single process. Halving the token cap halves it; 1h on the debug queue covers
# a worklist of tens of accessions at these settings.
NUM_CANDIDATES=64      # best-of-N candidates per emitted sequence
NUM_OUTPUTS=5          # sequences kept per accession
SELECTION=margin       # margin | pos
PANEL_SIZE=256         # reference captions the margin subtracts against
TEMPERATURE=1.0
TOP_P=0.95
# The corpus is filtered to <=500 residues, so 512 covers every target. Wall time
# is linear in this, and best-of-N multiplies it by NUM_CANDIDATES.
MAX_NEW_TOKENS=512

# ===========================================================================
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "text2protein generation set (src.generate_set)" \
    RETRIEVAL_CKPT DECODER_CKPT ID_FILE OUT \
    NUM_CANDIDATES NUM_OUTPUTS SELECTION PANEL_SIZE \
    TEMPERATURE TOP_P MAX_NEW_TOKENS
require_files RETRIEVAL_CKPT DECODER_CKPT ID_FILE

mkdir -p "$(dirname "${OUT}")"
python -m src.generate_set --device xpu \
    --retrieval-ckpt "${RETRIEVAL_CKPT}" \
    --decoder-ckpt "${DECODER_CKPT}" \
    --id-file "${ID_FILE}" --out "${OUT}" \
    --num-candidates "${NUM_CANDIDATES}" --num-outputs "${NUM_OUTPUTS}" \
    --selection "${SELECTION}" --panel-size "${PANEL_SIZE}" \
    --temperature "${TEMPERATURE}" --top-p "${TOP_P}" \
    --max-new-tokens "${MAX_NEW_TOKENS}"
rc=$?

echo "csv at ${OUT}"
finish $rc
