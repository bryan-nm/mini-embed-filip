#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_p2t_sft
#PBS -l walltime=16:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m abe

# ---------------------------------------------------------------------------
# protein -> text SFT. See train_t2p_SFT.pbs for the other half.
#
# What is specific to THIS direction — and why it does NOT inherit the t2p
# settings:
#   MAX_TARGET_TOKENS=512   the target is a caption, and the text encoder caps
#                           at 512 tokens anyway (DataCfg.max_text_tokens), so
#                           512 already covers the corpus. This value has never
#                           moved with the protein cap — it is a caption limit,
#                           not a protein one.
#   no direction augment    BioGPT has no C-to-N marker. reverse_prefix_ids()
#                           raises for a non-Mixtral decoder by design, so
#                           passing the flag here fails the job rather than
#                           silently training a directionless decoder on
#                           reversed text. Reversed captions are meaningless
#                           anyway — the augmentation is a protein trick.
#   BATCH_SIZE=8, CAE=2     BioGPT is 24 layers; cross-attn every other layer,
#                           smaller batch.
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

MASTER_PORT=29503
source ./pbs_common.sh

# ===========================================================================
# Checkpoints
# ===========================================================================
RETRIEVAL_CKPT=checkpoints/retrieval/epoch50.pt
CKPT_DIR=checkpoints/generation            # writes <CKPT_DIR>/protein2text/

# ===========================================================================
# Hyperparameters
# ===========================================================================
# BATCH_SIZE stays at 8 despite the shorter proteins. This direction's cost is
# dominated by BioGPT's own forward over a 512-token CAPTION target, which the
# corpus change does not touch; only the cross-attention memory axis (the
# protein source) halved, and that is not the binding term. Raising the batch
# here would be sizing against the wrong tensor.
#
# WALL TIME BASIS: unchanged per step, so the only saving is fewer rows. Kept at
# 16h for that reason — this is the slowest job in the repo per step and the one
# least helped by the shorter proteins.
BATCH_SIZE=8
EPOCHS=20
LR=1.5e-4
GRAD_CKPT=0
MAX_TARGET_TOKENS=512
CROSS_ATTN_EVERY=2
CROSS_ATTN_MODE=aligned
MEMORY_SPACE=aligned
UNFREEZE_TOP=0
UNFREEZE_WHERE=top
VAL_SUBSET=100

# Cross-attention coverage aux — see train_t2p_SFT.pbs for what it does.
#
# COV_TAU=0.007 is MEASURED-VALIDATED, but not by the reasoning that produced
# it. It was derived as 2.4 * an ASSUMED unif~0.003; the measured unif is
# 0.00490, so the intended 2.4x multiple would have been 0.012. Keeping 0.007
# anyway, because what matters is the fraction of source positions the penalty
# bites on, and on the measured distribution 0.007 lands well:
#
#   p2t measured: unif=0.00490  p10=0.0030  p50=0.0098  p90=0.0741
#   frac_below <0.001:0.001 <0.005:0.245 <0.01:0.506 <0.05:0.860  (n=42,984)
#
#   tau=0.007 penalizes ~37% of positions   (t2p's tau=0.025 penalizes ~49%)
#   tau=0.012 would penalize ~55%           and needs COV_LAMBDA ~0.13, not 0.5
#
# The loss scale is confirmed, not estimated: at tau=0.007 the measured covpen
# is 0.031, so COV_LAMBDA=0.5 contributes 0.0155 against val ce 1.119 — 1.4% of
# the loss, in the intended band. The pair moves together.
#
# Structural note: ~25% of p2t source positions sit at or below uniform, against
# ~20% for t2p. The starved tail is not a t2p quirk — both directions ignore a
# comparable slice of the source.
COV_LAMBDA=0.5
COV_TAU=0.007

# Per-epoch round-trip retrieval eval (free-running; the prefix-free counterpart
# to val CE). The pool is sharded across ranks, so 512 rows is 2-3 rows/rank.
# RT_MAX_NEW is the real cost knob; RT_SAMPLES=0 turns the eval off.
RT_SAMPLES=512
RT_MAX_NEW=${MAX_TARGET_TOKENS}

# ===========================================================================
EXTRA=""
[ "$GRAD_CKPT" = 1 ] && EXTRA="--grad-checkpointing"
if [ "$RT_SAMPLES" = 0 ]; then
    EXTRA="${EXTRA} --no-rt-eval"
else
    EXTRA="${EXTRA} --rt-samples ${RT_SAMPLES} --rt-max-new-tokens ${RT_MAX_NEW}"
fi

if [ "$GRAD_CKPT" = 1 ] && [ "$COV_LAMBDA" != "0.0" ] && [ "$COV_LAMBDA" != "0" ]; then
    echo "FATAL: COV_LAMBDA>0 cannot be combined with GRAD_CKPT=1 — under" >&2
    echo "       checkpointing the aux reads last_attn from the no_grad pass and" >&2
    echo "       would train as a silent no-op. The trainer rejects this too; this" >&2
    echo "       check just fails before burning the queue slot on model loading." >&2
    exit 1
fi

slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "protein2text SFT (src.train_generation)" \
    RETRIEVAL_CKPT CKPT_DIR \
    BATCH_SIZE EPOCHS LR GRAD_CKPT MAX_TARGET_TOKENS \
    CROSS_ATTN_EVERY CROSS_ATTN_MODE MEMORY_SPACE UNFREEZE_TOP UNFREEZE_WHERE \
    COV_LAMBDA COV_TAU RT_SAMPLES RT_MAX_NEW VAL_SUBSET
require_files RETRIEVAL_CKPT

# Per epoch, [gen][rt] reports free-running round-trip retrieval on a fixed val
# pool (generated caption -> its source protein, R@K/mAP, plus the ceiling from
# the true captions) and the mean generated vs true caption length. Val CE is
# teacher-forced and can improve while this sits at the floor; full history lands
# in <CKPT_DIR>/protein2text/sft_roundtrip.jsonl.
"${MPI_LAUNCH[@]}" \
    python -m src.train_generation --direction protein2text --device xpu \
    --retrieval-ckpt "${RETRIEVAL_CKPT}" --ckpt-dir "${CKPT_DIR}" \
    --memory-space "${MEMORY_SPACE}" --cross-attn-mode "${CROSS_ATTN_MODE}" \
    --cross-attn-every "${CROSS_ATTN_EVERY}" \
    --unfreeze-top "${UNFREEZE_TOP}" --unfreeze-where "${UNFREEZE_WHERE}" \
    --batch-size "${BATCH_SIZE}" --epochs "${EPOCHS}" --lr "${LR}" \
    --max-target-tokens "${MAX_TARGET_TOKENS}" \
    --coverage-lambda "${COV_LAMBDA}" --coverage-tau "${COV_TAU}" \
    --val-subset "${VAL_SUBSET}" ${EXTRA}

finish $?
