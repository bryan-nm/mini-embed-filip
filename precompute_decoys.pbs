#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_precompute_decoys
#PBS -l walltime=02:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# Packed per-token cache for the hard decoy captions (see src/decoys.py).
# Text-only: the protein side is reused from the base cache, so this is roughly
# `DECOYS_PER_ROW` x the *text* half of precompute.pbs and nothing more.
#
# Unlike the retrieval trainer this DOES read the corpus CSV — decoys are built
# from raw caption text, then encoded. config.py owns that path.
# ---------------------------------------------------------------------------

MASTER_PORT=29506
source ./pbs_common.sh

# ===========================================================================
# Inputs / outputs
# ===========================================================================
CACHE_DIR=cache
DECOY_DIR=cache/decoys

# ===========================================================================
# Hyperparameters
# ===========================================================================
DECOYS_PER_ROW=2       # decoys generated per caption
DECOY_SEED=1234        # plan RNG; separate from the split seed
SPLIT_SEED=0           # MUST match the seed train_retrieval ran with
BATCH_SIZE=64

# ===========================================================================
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "decoy caption cache (src.precompute_decoys)" \
    CACHE_DIR DECOY_DIR DECOYS_PER_ROW DECOY_SEED SPLIT_SEED BATCH_SIZE
require_files CACHE_DIR

# --- 0) preflight: the plan needs the retrieval run's splits.json to keep donors
# inside the owner's split. A stale one (e.g. left by a --subset-size smoke run
# in a directory later re-precomputed at full scale) fails the plan step. Splits
# are a deterministic function of the cache + seed, so regenerating reproduces
# exactly what train_retrieval used — hence SPLIT_SEED must match.
python -m src.rebuild_splits --cache-dir "${CACHE_DIR}" --check || {
    echo "splits.json missing or stale; regenerating at seed ${SPLIT_SEED}"
    python -m src.rebuild_splits --cache-dir "${CACHE_DIR}" --seed "${SPLIT_SEED}" || exit 1
}

# --- 1) plan: one process parses every caption and assigns (field, donor) swaps.
# Deterministic and reusable, so it is skipped when it already exists. A failure
# here MUST abort the job: without a plan every one of the ${NRANKS} ranks below
# dies on the first line, burning the whole allocation for nothing.
if [ ! -f "${DECOY_DIR}/decoy_plan.pt" ]; then
    echo "building decoy plan (single process)"
    python -m src.precompute_decoys --plan-only \
        --cache-dir "${CACHE_DIR}" --decoy-cache-dir "${DECOY_DIR}" \
        --decoys-per-row "${DECOYS_PER_ROW}" --decoy-seed "${DECOY_SEED}" || {
        echo "decoy plan FAILED; not launching the ${NRANKS}-rank encode" >&2
        exit 1
    }
else
    echo "reusing existing ${DECOY_DIR}/decoy_plan.pt"
fi

# --- 2) encode + merge: all ranks encode a slice of the plan, rank 0 merges.
"${MPI_LAUNCH[@]}" \
    python -m src.precompute_decoys --device xpu --batch-size "${BATCH_SIZE}" \
        --cache-dir "${CACHE_DIR}" --decoy-cache-dir "${DECOY_DIR}"
rc=$?

# Coverage lands in decoy_stats.json — check rows_with_usable_decoy/rows_total
# before launching the training phase.
[ -f "${DECOY_DIR}/decoy_stats.json" ] && cat "${DECOY_DIR}/decoy_stats.json"
finish $rc
