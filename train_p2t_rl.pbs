#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_p2t_rl
#PBS -l walltime=12:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m abe

# ---------------------------------------------------------------------------
# GRPO-style RL fine-tune of protein->text generation. Run FIRST as a de-risking
# testbed for the RL machinery: protein2text already conditions well (warm
# start, dense reward), so reward-up -> round-trip-up validates the loop, tunes
# the hyperparameters, and serves as a control for the harder text2protein
# direction. Separate track from train_generation.py; writes to <CKPT_DIR>.
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

MASTER_PORT=29505
# PBS runs this from a spooled copy with $HOME as the working directory, so the
# cd MUST come before the source — see pbs_common.sh.
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./pbs_common.sh

# ===========================================================================
# Checkpoints
# ===========================================================================
RETRIEVAL_CKPT=checkpoints/retrieval/epoch50.pt
CKPT_DIR=checkpoints/generation/protein2text_rl

# Initial policy. Set INIT_CKPT to an SFT checkpoint to continue it (WARM START:
# the architecture then comes from that checkpoint's header and the CROSS_ATTN_*
# / UNFREEZE_* settings below are ignored), or leave it EMPTY to COLD START from
# freshly-initialized adapters on the frozen decoder — see train_t2p_rl.pbs for
# the full rationale. Cold start is the cleaner control here than in t2p, since
# BioGPT's fluency prior means a cold policy still emits well-formed captions
# from step 0; only their content has to be learned.
INIT_CKPT=checkpoints/generation/protein2text/epoch19.pt
#INIT_CKPT=                                  # <- uncomment for a cold start

# ===========================================================================
# Hyperparameters
# ===========================================================================
# WALL TIME BASIS: RL is step-budgeted, not row-budgeted — wall time is STEPS x
# per-step. Nothing here moved with the corpus: the caption target is still 128
# tokens and BioGPT is unchanged; only the protein SOURCE halved, which is not
# the binding term. 12h stands.
STEPS=2000
PROMPTS_PER_RANK=8
GROUP_SIZE=8
LR=1e-5
UNFREEZE_LR=2e-6
KL_COEF=0.05
LOG_EVERY=10
SAVE_EVERY=200

# Text targets are short, so 128 keeps rollouts cheap (this direction iterates
# faster than text2protein). BioGPT's strong fluency prior plus the KL reference
# suppress text reward-hacking (repetition / keyword-stuffing).
MAX_NEW_TOKENS=128
TEMPERATURE=1.0
TOP_P=0.95

# Contrastive reward and length band both ON, but calibrated from different
# evidence — worth keeping straight when reading a run that goes wrong:
#
#   REWARD_CONTRASTIVE has no direction-specific constant to get wrong. Its only
#   parameter is beta, and beta=1.0 is the best_of_n margin definition, which is
#   modality-agnostic. LOG_MARGIN_CEILING reports cmargin (the same statistic on
#   ground-truth pairs) so this run self-calibrates: margin tracking cmargin
#   means the generations are as specific as the references; margin far below
#   cmargin means they are generic. See train_t2p_rl.pbs for the full reasoning.
#
#   LENGTH_LAMBDA has to be sized against the reward actually in use — the two
#   differ here, unlike t2p where both gave the same answer. On the OLD corpus:
#   raw reward rstd 0.056-0.091 -> 0.31; contrastive rstd 0.077-0.104, mean
#   ~0.095 -> 4.5*rstd ~ 0.43, hence the 0.4 shipped here.
#
#   RE-MEASURE. Those numbers predate the corpus change. The target here is a
#   caption, whose length distribution the <=500-residue protein filter does not
#   directly touch — but the corpus is a different selection of proteins, so the
#   captions are a different sample too. The sizing rule (LENGTH_LAMBDA ~
#   4.5 * rstd, since only within-group spread survives GRPO's standardizer) is
#   what to re-apply, using this run's own first LOG_EVERY lines.
#
#   Direction of the error, on the old corpus: lenratio ran 0.55-0.74, i.e.
#   captions ~30% too SHORT, where t2p generations were ~70% too long. The band
#   is two-sided and log-symmetric, so the same penalty pushes captions longer
#   here; nothing about the sign needs changing. (Caveat even then: 5 steps per
#   measured job, and lenratio drifted upward within each run.)
#
# NOTE: the contrastive reward is on a different scale from the raw one, so
# reward curves here are not comparable to earlier p2t runs. R@K/mAP still are.
LENGTH_LAMBDA=0.4
LENGTH_TOLERANCE=0.25
REWARD_CONTRASTIVE=1
MARGIN_BETA=1.0
LOG_MARGIN_CEILING=1

EVAL_EVERY=200
EVAL_SAMPLES=1000
EVAL_MAX_NEW=${MAX_NEW_TOKENS}

# Cold-start architecture. IGNORED when INIT_CKPT is set.
#
# WARM_START_QALIGN must stay 0 here. The transplant copies the retrieval
# projection head's body into q_align, so it needs dec_hidden == proj_d_hidden
# (512) and dec_hidden//2 == proj_d_mid; BioGPT is 1024-hidden, so the shapes
# don't line up and decoder_adapters raises rather than silently skipping. It is
# a text2protein-only trick until q_align is rebuilt at the head's dims.
CROSS_ATTN_EVERY=2
CROSS_ATTN_MODE=aligned
UNFREEZE_TOP=0
UNFREEZE_WHERE=top
WARM_START_QALIGN=0

# ===========================================================================
REWARD_EXTRA=""
if [ "${REWARD_CONTRASTIVE}" = 1 ]; then
    REWARD_EXTRA="--reward-contrastive --reward-margin-beta ${MARGIN_BETA}"
    [ "${LOG_MARGIN_CEILING}" = 1 ] && REWARD_EXTRA="${REWARD_EXTRA} --log-margin-ceiling"
fi

# --resume auto continues from the latest checkpoint in CKPT_DIR (fresh start on
# the first run), so re-queuing after a wall-time kill picks up where it left
# off. STEPS is the TOTAL budget; INIT_CKPT stays the fixed KL anchor.
if [ -n "${INIT_CKPT}" ]; then
    INIT_ARGS="--init-ckpt ${INIT_CKPT}"
    START_MODE="warm (continuing SFT)"
else
    INIT_ARGS="--cross-attn-every ${CROSS_ATTN_EVERY} --cross-attn-mode ${CROSS_ATTN_MODE}"
    INIT_ARGS="${INIT_ARGS} --unfreeze-top ${UNFREEZE_TOP} --unfreeze-where ${UNFREEZE_WHERE}"
    [ "${WARM_START_QALIGN}" = 1 ] && INIT_ARGS="${INIT_ARGS} --warm-start-qalign"
    START_MODE="COLD (no SFT checkpoint)"
fi

slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "protein2text RL (src.train_rl)" \
    RETRIEVAL_CKPT INIT_CKPT CKPT_DIR START_MODE \
    STEPS PROMPTS_PER_RANK GROUP_SIZE LR UNFREEZE_LR KL_COEF \
    MAX_NEW_TOKENS TEMPERATURE TOP_P \
    LENGTH_LAMBDA LENGTH_TOLERANCE \
    REWARD_CONTRASTIVE MARGIN_BETA LOG_MARGIN_CEILING \
    EVAL_EVERY EVAL_SAMPLES EVAL_MAX_NEW SAVE_EVERY LOG_EVERY \
    CROSS_ATTN_EVERY CROSS_ATTN_MODE UNFREEZE_TOP UNFREEZE_WHERE WARM_START_QALIGN
require_files RETRIEVAL_CKPT INIT_CKPT

# RL rollouts are embarrassingly parallel: the effective GRPO batch scales with
# NRANKS.
"${MPI_LAUNCH[@]}" \
    python -m src.train_rl --direction protein2text --device xpu \
    --retrieval-ckpt "${RETRIEVAL_CKPT}" --ckpt-dir "${CKPT_DIR}" ${INIT_ARGS} \
    --resume auto --steps "${STEPS}" \
    --prompts-per-rank "${PROMPTS_PER_RANK}" --group-size "${GROUP_SIZE}" \
    --max-new-tokens "${MAX_NEW_TOKENS}" \
    --temperature "${TEMPERATURE}" --top-p "${TOP_P}" \
    --lr "${LR}" --unfreeze-lr "${UNFREEZE_LR}" --kl-coef "${KL_COEF}" \
    --length-lambda "${LENGTH_LAMBDA}" --length-tolerance "${LENGTH_TOLERANCE}" \
    --log-every "${LOG_EVERY}" --save-every "${SAVE_EVERY}" ${REWARD_EXTRA} \
    --eval-every "${EVAL_EVERY}" --eval-samples "${EVAL_SAMPLES}" \
    --eval-max-new-tokens "${EVAL_MAX_NEW}"

finish $?
