#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_p2t_rl
#PBS -l walltime=12:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m abe

module load frameworks
source /flare/NLDesignProtein/bryan/envs/filip-env/bin/activate
cd /flare/NLDesignProtein/bryan/FILIP-dev-space/mini-embed-filip

# GRPO-style RL fine-tune of protein->text generation. Run FIRST as a de-risking
# testbed for the RL machinery: protein2text already conditions well (warm start,
# dense reward), so reward-up -> round-trip-up validates the loop, tunes the
# hyperparameters, and serves as a control for the harder text2protein direction.
# Separate track from train_generation.py; writes to
# checkpoints/generation/protein2text_rl/.
: "${RCKPT:?set -v RCKPT=path/to/retrieval/epochNN.pt}"
: "${INIT_CKPT:?set -v INIT_CKPT=path/to/sft/protein2text/epochNN.pt (the working ckpt)}"

# Contrastive reward and length band both ON, but calibrated from different
# evidence — worth keeping straight when reading a run that goes wrong:
#
#   REWARD_CONTRASTIVE has no direction-specific constant to get wrong. Its only
#   parameter is beta, and beta=1.0 is the best_of_n margin definition, which is
#   modality-agnostic. --log-margin-ceiling reports cmargin (the same statistic on
#   ground-truth pairs) so this run self-calibrates: margin tracking cmargin means
#   the generations are as specific as the references; margin far below cmargin
#   means they are generic. See train_t2p_rl.pbs for the full reasoning.
#
#   LEN_LAMBDA is measured for THIS direction, and it has to be sized against the
#   reward actually in use — the two differ here, unlike t2p where both gave the
#   same answer. Job 8723416 (raw): rstd 0.056-0.091 -> 0.31. Job 8723638
#   (contrastive, the default above): rstd 0.077-0.104, mean ~0.095 -> 4.5*rstd
#   ~ 0.43. Shipping 0.4 for the contrastive reward. Drop to 0.3 if you set
#   REWARD_CONTRASTIVE=0.
#
#   The trigger condition is met, but in the OPPOSITE direction from t2p —
#   lenratio ran 0.55-0.74 across BOTH jobs, i.e. generated captions are ~30% too
#   SHORT, where t2p generations were ~70% too long. The band is two-sided and
#   log-symmetric, so the same penalty pushes captions longer here; nothing about
#   the sign needs changing.
#
#   Caveat: 5 steps per job. lenratio drifted upward within each run
#   (0.55 -> ~0.74), which may be warmup rather than a stable level, though it
#   reproduced across two independent jobs. Re-read rstd and lenratio from the
#   first --log-every 10 lines of this run and adjust if they disagree.
#
# NOTE: the contrastive reward is on a different scale from the raw one, so reward
# curves here are not comparable to earlier p2t runs. R@K/mAP still are.
LEN_LAMBDA=${LEN_LAMBDA:-0.4}
REWARD_CONTRASTIVE=${REWARD_CONTRASTIVE:-1}
MARGIN_BETA=${MARGIN_BETA:-1.0}

NNODES=$(wc -l < "$PBS_NODEFILE"); RANKS_PER_NODE=12
NRANKS=$(( NNODES * RANKS_PER_NODE ))
# RL rollouts are embarrassingly parallel: effective GRPO batch scales with NRANKS.

export ONEAPI_DEVICE_SELECTOR="level_zero:gpu"
export FILIP_MODELS_DIR=/flare/NLDesignProtein/bryan/FILIP-dev-space/models
# protein2text decoder: BioGPT (24-layer dense). Both encoders are also loaded
# (protein source memory + text reward re-encode), staged under MODELS_DIR.
export FILIP_TEXT_DECODER=${FILIP_MODELS_DIR}/biogpt
export FILIP_DATA_CSV=/flare/NLDesignProtein/bryan/FILIP-dev-space/datasets/SwissProt_full/fully_annotated_swiss_prot_20260722.csv
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export MASTER_ADDR=$(head -n1 "$PBS_NODEFILE")
export MASTER_PORT=29505
export OMP_NUM_THREADS=8
export CCL_PROCESS_LAUNCHER=pmix
export CCL_ATL_TRANSPORT=mpi
# Route the rank/KVS exchange over MPI (PMIx) — see train_generation.pbs.
export CCL_KVS_MODE=mpi
export CCL_KVS_CONNECTION_TIMEOUT=600
export FI_PROVIDER=cxi
export CCL_ZE_IPC_EXCHANGE=pidfd

source ~/bin/slack_notify.sh
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"

# Architecture (cross_attn_every, unfreeze, LoRA targets) is inherited from
# INIT_CKPT's metadata. Text targets are short, so max-new-tokens 128 keeps
# rollouts cheap (this direction iterates faster than text2protein). BioGPT's
# strong fluency prior + the KL reference suppress text reward-hacking
# (repetition / keyword-stuffing).
# --resume auto continues from the latest checkpoint in the output dir (fresh
# start on the first run), so re-queuing this job after a wall-time kill picks up
# where it left off. --steps is the TOTAL budget; INIT_CKPT stays the fixed KL
# anchor across restarts.
# --eval-every 200 runs the held-out round-trip metric (fixed 1000 val rows,
# sharded across ranks) alongside each checkpoint -> checkpoints/.../rl_roundtrip.jsonl.
# The reward alone can't distinguish real conditioning from drift toward one
# generic high-scoring caption; the pooled R@K/mAP can. ~1 rollout of extra
# generation per eval, so <1% of wall time at this cadence.
REWARD_EXTRA=""
[ "${REWARD_CONTRASTIVE}" = 1 ] && REWARD_EXTRA="--reward-contrastive \
    --reward-margin-beta ${MARGIN_BETA} --log-margin-ceiling"

echo "p2t RL: len_lambda=${LEN_LAMBDA} contrastive=${REWARD_CONTRASTIVE} beta=${MARGIN_BETA}"

mpiexec -n ${NRANKS} -ppn ${RANKS_PER_NODE} --pmi=pmix --cpu-bind depth -d 8 \
    python -m src.train_rl --direction protein2text \
    --retrieval-ckpt "${RCKPT}" --init-ckpt "${INIT_CKPT}" --device xpu \
    --resume auto --steps 2000 --prompts-per-rank 8 --group-size 8 \
    --max-new-tokens 128 --temperature 1.0 --top-p 0.95 \
    --lr 1e-5 --unfreeze-lr 2e-6 --kl-coef 0.05 \
    --length-lambda "${LEN_LAMBDA}" --length-tolerance 0.25 \
    --log-every 10 --save-every 200 ${REWARD_EXTRA} \
    --eval-every 200 --eval-samples 1000

rc=$?
if [ $rc -eq 0 ]; then
    slack ":white_check_mark: DONE ${PBS_JOBID} ${PBS_JOBNAME}"
else
    slack ":x: FAILED (exit ${rc}) ${PBS_JOBID} ${PBS_JOBNAME}"
fi
exit $rc
