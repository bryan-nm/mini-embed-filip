#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_precompute
#PBS -l walltime=01:00:00
#PBS -l select=2
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# One-shot per-token encoder cache. All ranks encode their shard; rank 0 merges
# into CACHE_DIR at the end (and writes the corpus-mean feature vectors).
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

MASTER_PORT=29500
# PBS runs this from a spooled copy with $HOME as the working directory, so the
# cd MUST come before the source — see pbs_common.sh.
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./pbs_common.sh

# ===========================================================================
# Outputs
# ===========================================================================
CACHE_DIR=cache

# ===========================================================================
# Hyperparameters
# ===========================================================================
# Encoder batch. 64 is the KNOWN-GOOD value — the only one with a completed run
# behind it. It was briefly raised to 128 on the theory that the 512-token cap
# left headroom in AMPLIFY's O(BATCH_SIZE * seqlen^2) attention; job 8731358 then
# died ~6 min in with a GPU page fault (one rank aborted, the rest were torn
# down). Reverted, because a completed run beats an argument.
#
# For the record, that argument does NOT explain the crash, so do not assume 64
# is the fix: at B=128/L=512 the [B,H,L,L] fp32 tensors are ~1.9 GB each, LESS
# than the ~3.8 GB the known-good B=64/L=1024 config carried. If 64 also faults,
# the batch was never the cause — see the debug recipe below.
BATCH_SIZE=64

# --- if this job faults again -------------------------------------------------
# The failure signature to match is:
#   "Segmentation fault from GPU at 0x..., type: 0 (NotPresent), access: 1 (Write)"
# That is a DEVICE-side page fault, not filesystem contention — a shared-FS
# problem shows up as EIO/SIGBUS on an mmap'd page or as a hang, not as a GPU
# PDE fault. So dropping the node count is a way to iterate cheaply, not a fix.
#
# Bisect on 2 nodes in the debug queue (edit the two PBS lines at the top):
#   #PBS -l select=2
#   #PBS -q debug
# and add --subset-size to bound it, e.g. `--subset-size 20000` on the python
# line below. Then, in order:
#   1. Does it survive at all on 2 nodes? If yes, raise nodes until it faults —
#      that points at scale/fabric, not the encoder.
#   2. If it faults on 2 nodes too, it is per-rank: bisect BATCH_SIZE down.
#   3. Note WHICH node the aborting rank sat on. Aurora tiles do fail
#      individually; if a re-run at identical settings dies on the SAME node it
#      is that node, and if it dies on a DIFFERENT one it is systematic. That
#      one bit is the cheapest thing to establish first — just resubmit.
#
# WALL TIME BASIS: measured on the crashed job — rank 0 ran 14.9 proteins/s, so
# ~2998 proteins/rank is ~3.4 min for the protein phase; text is a comparable
# pass. The corpus has ~575k unique proteins (8.9x the old 64.7k, since captions
# no longer repeat them), and it still lands far inside 2h.

# ===========================================================================
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "per-token encoder cache (src.precompute)" CACHE_DIR BATCH_SIZE

"${MPI_LAUNCH[@]}" \
    python -m src.precompute --device xpu \
        --batch-size "${BATCH_SIZE}" --cache-dir "${CACHE_DIR}"

finish $?
