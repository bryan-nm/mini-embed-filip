#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_precompute
#PBS -l walltime=02:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# One-shot per-token encoder cache. All ranks encode their shard; rank 0 merges
# into CACHE_DIR at the end (and writes the corpus-mean feature vectors).
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

MASTER_PORT=29500
source ./pbs_common.sh

# ===========================================================================
# Outputs
# ===========================================================================
CACHE_DIR=cache

# ===========================================================================
# Hyperparameters
# ===========================================================================
# Encoder batch. AMPLIFY attention is materialized full (~[B,H,L,L]) on the
# non-fused XPU path, so memory is O(BATCH_SIZE * seqlen^2). 64 was the largest
# that fit at the old 1024-token protein cap; at 512 that term is 4x smaller,
# while the fp32 hidden-state buffers (O(B*L*d)) only halve — so the real
# headroom is between 2x and 4x. 128 takes the conservative end: if it runs with
# room to spare, 256 is the ceiling the L^2 term allows; if it OOMs, go back.
#
# WALL TIME BASIS: per-protein encode is ~4x cheaper at a 512 cap, and the text
# side no longer repeats a protein's row per caption. 2h has slack against the
# old 3h before the row count is even counted — check the [precompute] items/s
# line on the first job and re-trim.
BATCH_SIZE=128

# ===========================================================================
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "per-token encoder cache (src.precompute)" CACHE_DIR BATCH_SIZE

"${MPI_LAUNCH[@]}" \
    python -m src.precompute --device xpu \
        --batch-size "${BATCH_SIZE}" --cache-dir "${CACHE_DIR}"

finish $?
