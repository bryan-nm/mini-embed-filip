#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_t2p_rl
#PBS -l walltime=12:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m abe

# ---------------------------------------------------------------------------
# GRPO-style RL fine-tune of text->protein generation, optimizing the round-trip
# FILIP reward directly (the honest, prefix-free objective). Separate track from
# train_generation.py; writes to <CKPT_DIR>.
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

MASTER_PORT=29504
source ./pbs_common.sh

# ===========================================================================
# Checkpoints
# ===========================================================================
RETRIEVAL_CKPT=checkpoints/retrieval/epoch50.pt
CKPT_DIR=checkpoints/generation/text2protein_rl

# Initial policy. Two supported modes:
#
#   WARM START — set INIT_CKPT to an SFT checkpoint (the cleanest-LM one, NOT
#   the contrastive one whose no-memory behaviour is damaged). The policy
#   continues that model and the architecture comes from its stored header, so
#   the CROSS_ATTN_* / UNFREEZE_* settings below are ignored. KL anchors to the
#   SFT policy.
#
#   COLD START — leave INIT_CKPT empty. The adapters are freshly initialized on
#   the frozen decoder and RL is the only thing that ever shapes the
#   conditioning; the architecture comes from the settings below and KL anchors
#   to the decoder's unconditional prior. o_proj is zero-initialized, so step 0
#   IS that prior and the reward gradient opens the adapter from there. Legal
#   and useful as a no-SFT control, but expect a much longer flat stretch before
#   the round-trip curve moves — WARM_START_QALIGN matters most in this mode,
#   since it is the only thing putting the decoder-side query in the right region
#   of the shared space before any gradient arrives.
INIT_CKPT=checkpoints/generation/text2protein/epoch09.pt
#INIT_CKPT=                                  # <- uncomment for a cold start

# ===========================================================================
# Hyperparameters
# ===========================================================================
# WALL TIME BASIS: RL is step-budgeted, not row-budgeted, so wall time is
# STEPS x per-step. Rollout generation is the floor and is linear in
# MAX_NEW_TOKENS (halved), while PROMPTS_PER_RANK doubled — so per-step wall is
# roughly unchanged at twice the GRPO batch. 12h stands.
STEPS=2000                  # TOTAL budget; --resume auto continues toward it
PROMPTS_PER_RANK=16         # B: distinct captions per rank per step
GROUP_SIZE=8                # G: rollouts per caption. Rollout = B*G per rank
LR=1e-5
UNFREEZE_LR=2e-6            # only bites if the policy has unfrozen blocks
KL_COEF=0.05
LOG_EVERY=10
SAVE_EVERY=200

# Rollout budget. This has to cover the whole target, not part of it: the FILIP
# reward compares a truncated rollout against the WHOLE caption, so caption
# tokens describing anything past the cap can only be satisfied by cramming that
# content into the visible window — which, for a two-domain prompt, rewards
# chimeras over correct domain order. The corpus is filtered to <=500 residues,
# so 512 covers every protein and the reward always scores a finished sequence.
# (This was 1024 for the unfiltered corpus, and 256 before that, which sat below
# the median protein and did exactly the damage described above.)
#
# PROMPTS_PER_RANK doubled with the halved rollout: the policy's
# forward-with-grad over B*G sequences scales as B*G*T on the linear term and
# B*G*T^2 on attention, so halving T pays for twice the prompts outright.
# train_rl has no gradient checkpointing — for a larger decoder drop
# PROMPTS_PER_RANK first, and keep GROUP_SIZE at 8, since group-relative
# advantage degrades fast with a small group.
MAX_NEW_TOKENS=512
TEMPERATURE=1.0
TOP_P=0.95

# Length band on the reward. RE-MEASURE BEFORE TRUSTING THIS NUMBER: 0.4 was
# derived on the UNFILTERED corpus at MAX_NEW_TOKENS=1024 (epoch-6 SFT policy,
# lenratio 1.57-2.21 median ~1.7, i.e. generations ~70% too long; rstd 0.05-0.12
# under both rewards, and 4.5 * 0.09 ~ 0.4 is the sizing rule). Both inputs to
# that calculation have changed — the corpus is now capped at 500 residues, so
# the target length distribution is different, and the rollout cap moved with it.
#
# The sizing rule itself still holds: only within-group spread survives GRPO's
# standardizer, so LENGTH_LAMBDA ~ 4.5 * rstd. Read `rstd` and `lenratio` off the
# first LOG_EVERY lines of this run and set it from those. 0.4 is a starting
# point carried over, not a measurement on this corpus. Set to 0 for no band.
LENGTH_LAMBDA=0.4
LENGTH_TOLERANCE=0.25

# Contrastive reward: FILIP(gen, own caption) - beta * max_j FILIP(gen, other
# caption in batch), instead of the raw positive score. The raw score is absolute
# and negative-free, so it can be raised by a "hub" output that scores well
# against EVERY caption; GRPO's standardizer cannot see that (it removes a
# per-prompt constant, and hubness is a property of the sample).
#
# Prior runs showed margin -0.09 to -0.16 every step while the raw score looked
# healthy at ~0.7 — the hubness signature. That is SUGGESTIVE, NOT ESTABLISHED:
# the negative term is a MAX over B-1 draws and is upward-biased against a single
# positive draw, so a negative margin is partly a property of the statistic.
# LOG_MARGIN_CEILING settles it in this run's own log: cmargin is the identical
# statistic on GROUND-TRUTH pairs. If margin tracks cmargin, the negative number
# was the max-statistic and means nothing. If cmargin sits well above margin, the
# generations really are generic and this reward is doing its job. Read it in the
# first few step lines. The reward changed scale, so reward curves are NOT
# comparable to earlier runs — R@K/mAP still are.
REWARD_CONTRASTIVE=1
MARGIN_BETA=1.0
LOG_MARGIN_CEILING=1

# Held-out round-trip eval alongside each checkpoint -> <CKPT_DIR>/rl_roundtrip.jsonl.
# The reward alone can't distinguish real conditioning from drift toward one
# generic high-scoring output; the pooled R@K/mAP can. ~1 rollout of extra
# generation per eval, so <1% of wall time at this cadence.
EVAL_EVERY=200
EVAL_SAMPLES=1000
EVAL_MAX_NEW=${MAX_NEW_TOKENS}

# Cold-start architecture. IGNORED when INIT_CKPT is set — a continued run takes
# its architecture from the checkpoint's own header, so it cannot be reshaped.
CROSS_ATTN_EVERY=1
CROSS_ATTN_MODE=aligned
UNFREEZE_TOP=2
UNFREEZE_WHERE=top
WARM_START_QALIGN=1

# ===========================================================================
REWARD_EXTRA=""
if [ "${REWARD_CONTRASTIVE}" = 1 ]; then
    REWARD_EXTRA="--reward-contrastive --reward-margin-beta ${MARGIN_BETA}"
    [ "${LOG_MARGIN_CEILING}" = 1 ] && REWARD_EXTRA="${REWARD_EXTRA} --log-margin-ceiling"
fi

# Warm vs cold start. --resume auto continues from the latest checkpoint in
# CKPT_DIR (fresh start on the first run) either way, so re-queuing after a
# wall-time kill picks up where it left off; INIT_CKPT stays the fixed KL anchor
# across restarts.
if [ -n "${INIT_CKPT}" ]; then
    INIT_ARGS="--init-ckpt ${INIT_CKPT}"
    START_MODE="warm (continuing SFT)"
else
    INIT_ARGS="--cross-attn-every ${CROSS_ATTN_EVERY} --cross-attn-mode ${CROSS_ATTN_MODE}"
    INIT_ARGS="${INIT_ARGS} --unfreeze-top ${UNFREEZE_TOP} --unfreeze-where ${UNFREEZE_WHERE}"
    [ "${WARM_START_QALIGN}" = 1 ] && INIT_ARGS="${INIT_ARGS} --warm-start-qalign"
    START_MODE="COLD (no SFT checkpoint)"
fi

slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "text2protein RL (src.train_rl)" \
    RETRIEVAL_CKPT INIT_CKPT CKPT_DIR START_MODE \
    STEPS PROMPTS_PER_RANK GROUP_SIZE LR UNFREEZE_LR KL_COEF \
    MAX_NEW_TOKENS TEMPERATURE TOP_P \
    LENGTH_LAMBDA LENGTH_TOLERANCE \
    REWARD_CONTRASTIVE MARGIN_BETA LOG_MARGIN_CEILING \
    EVAL_EVERY EVAL_SAMPLES EVAL_MAX_NEW SAVE_EVERY LOG_EVERY \
    CROSS_ATTN_EVERY CROSS_ATTN_MODE UNFREEZE_TOP UNFREEZE_WHERE WARM_START_QALIGN
require_files RETRIEVAL_CKPT INIT_CKPT

# RL rollouts are embarrassingly parallel: each rank draws its own prompts, so
# the effective GRPO batch scales with NRANKS (more nodes -> larger,
# lower-variance batch, better cold-start exploration). Wall time per step is
# floored by the serial generation latency, not node count.
"${MPI_LAUNCH[@]}" \
    python -m src.train_rl --direction text2protein --device xpu \
    --retrieval-ckpt "${RETRIEVAL_CKPT}" --ckpt-dir "${CKPT_DIR}" ${INIT_ARGS} \
    --resume auto --steps "${STEPS}" \
    --prompts-per-rank "${PROMPTS_PER_RANK}" --group-size "${GROUP_SIZE}" \
    --max-new-tokens "${MAX_NEW_TOKENS}" \
    --temperature "${TEMPERATURE}" --top-p "${TOP_P}" \
    --lr "${LR}" --unfreeze-lr "${UNFREEZE_LR}" --kl-coef "${KL_COEF}" \
    --length-lambda "${LENGTH_LAMBDA}" --length-tolerance "${LENGTH_TOLERANCE}" \
    --log-every "${LOG_EVERY}" --save-every "${SAVE_EVERY}" ${REWARD_EXTRA} \
    --eval-every "${EVAL_EVERY}" --eval-samples "${EVAL_SAMPLES}" \
    --eval-max-new-tokens "${EVAL_MAX_NEW}"

finish $?
