#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_t2p_rl
#PBS -l walltime=12:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m abe

module load frameworks
source /flare/NLDesignProtein/bryan/envs/filip-env/bin/activate
cd /flare/NLDesignProtein/bryan/FILIP-dev-space/mini-embed-filip

# GRPO-style RL fine-tune of text->protein generation, optimizing the round-trip
# FILIP reward directly (the honest, prefix-free objective). Separate track from
# train_generation.py; writes to checkpoints/generation/text2protein_rl/.
: "${RCKPT:?set -v RCKPT=path/to/retrieval/epochNN.pt}"
: "${INIT_CKPT:?set -v INIT_CKPT=path/to/sft/text2protein/epochNN.pt (cleanest-LM ckpt)}"

# Rollout budget. 256 capped rollouts BELOW the median SwissProt protein (~330
# residues), which broke the reward: the FILIP score compares a truncated rollout
# against the WHOLE caption, so caption tokens describing anything past residue
# 256 could only be satisfied by cramming that content into the visible window.
# For a two-domain prompt that rewards chimeras over correct domain order. 1024
# covers essentially the whole corpus, so the reward scores a finished protein.
#
# Overridable from qsub (-v PPR=...): at 1024 the policy's forward-with-grad over
# B*G sequences is 4x the 256 footprint and train_rl has no gradient
# checkpointing. Sized for ProtGPT3-112M; for the 1.3B decoder (~4x per-token
# activations) drop PPR first — keep --group-size 8, since group-relative
# advantage degrades fast with a small group.
MAXNEW=${MAXNEW:-1024}
PPR=${PPR:-8}
# Length band on the reward, now ON. It was off pending evidence: the SFT-side
# fixes (no synthetic EOS on truncated targets, 1024 cap, bidirectional
# factorization) were expected to settle the length distribution by themselves,
# and the stated condition for reaching for this was "watch lenratio (median
# L_gen/L_true; 1.0 is on target)". That condition is now met by measurement —
# debug jobs 8722544 and 8722785 (epoch-6 SFT policy, MAXNEW=1024) both ran
# lenratio 1.57-2.21, median ~1.7. Generations are consistently ~70% too long.
# 0.4 is the sizing rule applied to the measured rstd: 4.5 * 0.09, where rstd
# came out 0.05-0.12 under BOTH the raw and contrastive rewards, so the same
# value holds either way. Set LEN_LAMBDA=0 to reproduce the old behaviour.
LEN_LAMBDA=${LEN_LAMBDA:-0.4}
# Contrastive reward, now ON: reward = FILIP(gen, own caption) - beta * max_j
# FILIP(gen, other caption in batch), instead of the raw positive score. The raw
# score is absolute and negative-free, so it can be raised by a "hub" output that
# scores well against EVERY caption; GRPO's standardizer cannot see that (it
# removes a per-prompt constant, and hubness is a property of the sample).
#
# Job 8722785 showed margin -0.09 to -0.16 every step while the raw score looked
# healthy at ~0.7 — the hubness signature. That is SUGGESTIVE, NOT ESTABLISHED:
# the negative term is a MAX over B-1 draws and is upward-biased against a single
# positive draw, so a negative margin is partly a property of the statistic.
# --log-margin-ceiling is enabled below and settles it in this run's own log:
#   cmargin is the identical statistic on GROUND-TRUTH pairs. If margin tracks
#   cmargin, the negative number was the max-statistic and means nothing. If
#   cmargin sits well above margin, the generations really are generic and this
#   reward is doing the job. Read it in the first few step lines.
# Watch eval R@K/mAP the same way as always — the reward changed scale, so reward
# curves are NOT comparable to earlier runs, but R@K still is.
# REWARD_CONTRASTIVE=0 reverts to the raw positive score.
REWARD_CONTRASTIVE=${REWARD_CONTRASTIVE:-1}
MARGIN_BETA=${MARGIN_BETA:-1.0}

NNODES=$(wc -l < "$PBS_NODEFILE"); RANKS_PER_NODE=12
NRANKS=$(( NNODES * RANKS_PER_NODE ))
# RL rollouts are embarrassingly parallel: each rank draws its own prompts, so the
# effective GRPO batch scales with NRANKS (more nodes -> larger, lower-variance
# batch, better cold-start exploration). Wall time per step is floored by the
# serial generation latency, not node count.

export ONEAPI_DEVICE_SELECTOR="level_zero:gpu"
export FILIP_MODELS_DIR=/flare/NLDesignProtein/bryan/FILIP-dev-space/models
# text2protein decoder: ProtGPT3-112M-dpo (Mixtral MoE). Both encoders are also
# loaded (text source memory + protein reward re-encode), staged under MODELS_DIR.
export FILIP_PROTEIN_DECODER=${FILIP_MODELS_DIR}/ProtGPT3-112M-dpo
export FILIP_DATA_CSV=/flare/NLDesignProtein/bryan/FILIP-dev-space/datasets/SwissProt_full/fully_annotated_swiss_prot_20260722.csv
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export MASTER_ADDR=$(head -n1 "$PBS_NODEFILE")
export MASTER_PORT=29504
export OMP_NUM_THREADS=8
export CCL_PROCESS_LAUNCHER=pmix
export CCL_ATL_TRANSPORT=mpi
# Route the rank/KVS exchange over MPI (PMIx), not oneCCL's internal TCP KVS —
# the internal single-rendezvous KVS overruns at O(1000s) of ranks. See
# train_generation.pbs for the full rationale.
export CCL_KVS_MODE=mpi
export CCL_KVS_CONNECTION_TIMEOUT=600
export FI_PROVIDER=cxi
export CCL_ZE_IPC_EXCHANGE=pidfd

source ~/bin/slack_notify.sh
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"

# The policy inherits its architecture (cross_attn_every, unfreeze, warm-start,
# LoRA targets) from INIT_CKPT's metadata, so we don't repeat those flags here.
# --unfreeze-lr only bites if INIT_CKPT had unfrozen blocks (then the decoder is
# upcast to fp32 for stable updates). max-new-tokens 256 fits protein targets;
# B=8 prompts x G=8 group = 64 rollouts/rank (halve --prompts-per-rank if OOM,
# since the policy is fp32 and a fp32 KL reference is also resident).
# --resume auto continues from the latest checkpoint in the output dir (fresh
# start on the first run), so re-queuing this job after a wall-time kill picks up
# where it left off. --steps is the TOTAL budget; INIT_CKPT stays the fixed KL
# anchor across restarts.
# --eval-every 200 runs the held-out round-trip metric (fixed 1000 val rows,
# sharded across ranks) alongside each checkpoint -> checkpoints/.../rl_roundtrip.jsonl.
# The reward alone can't distinguish real conditioning from drift toward one
# generic high-scoring output; the pooled R@K/mAP can. ~1 rollout of extra
# generation per eval, so <1% of wall time at this cadence.
REWARD_EXTRA=""
[ "${REWARD_CONTRASTIVE}" = 1 ] && REWARD_EXTRA="--reward-contrastive \
    --reward-margin-beta ${MARGIN_BETA} --log-margin-ceiling"

echo "t2p RL: len_lambda=${LEN_LAMBDA} contrastive=${REWARD_CONTRASTIVE} \
beta=${MARGIN_BETA} maxnew=${MAXNEW} ppr=${PPR}"

mpiexec -n ${NRANKS} -ppn ${RANKS_PER_NODE} --pmi=pmix --cpu-bind depth -d 8 \
    python -m src.train_rl --direction text2protein \
    --retrieval-ckpt "${RCKPT}" --init-ckpt "${INIT_CKPT}" --device xpu \
    --resume auto --steps 2000 --prompts-per-rank "${PPR}" --group-size 8 \
    --max-new-tokens "${MAXNEW}" --temperature 1.0 --top-p 0.95 \
    --lr 1e-5 --unfreeze-lr 2e-6 --kl-coef 0.05 \
    --length-lambda "${LEN_LAMBDA}" --length-tolerance 0.25 \
    --log-every 10 --save-every 200 ${REWARD_EXTRA} \
    --eval-every 200 --eval-samples 1000 --eval-max-new-tokens "${MAXNEW}"

rc=$?
if [ $rc -eq 0 ]; then
    slack ":white_check_mark: DONE ${PBS_JOBID} ${PBS_JOBNAME}"
else
    slack ":x: FAILED (exit ${rc}) ${PBS_JOBID} ${PBS_JOBNAME}"
fi
exit $rc
