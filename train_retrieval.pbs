#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_retrieval
#PBS -l walltime=08:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fsx
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# Two-phase FILIP retrieval training over the precomputed cache. Reads the token
# cache + pair_ids.json only; the CSV is touched solely on the --no-cache path.
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

MASTER_PORT=29501
# PBS runs this from a spooled copy with $HOME as the working directory, so the
# cd MUST come before the source — see pbs_common.sh.
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./pbs_common.sh

# ===========================================================================
# Inputs / outputs
# ===========================================================================
CACHE_DIR=cache
CKPT_DIR=checkpoints/retrieval

# ===========================================================================
# Hyperparameters
# ===========================================================================
# 16 nodes x 12 ranks = 192 ranks, in 12 contrastive subgroups of 16. Global
# negatives per anchor = GROUP_SIZE * BATCH_SIZE.
#
# BATCH_SIZE doubled from 16 with the 512-token protein cap. The binding
# constraint is the chunked FILIP transient — chunk * (GROUP_SIZE*BATCH_SIZE) *
# L_p * L_t * 4 bytes — which does NOT depend on embed_dim, since the einsum
# contracts it away before materializing the [.,.,L_p,L_t] array. At the old
# (B=16, L_p=1024) that was 4.0 GB; at (B=32, L_p=512) it is 4.0 GB again. Same
# footprint, twice the negative pool.
#
# NOTE this is a deliberate objective change, not only a memory one: each anchor
# now sees 512 negatives instead of 256, so retrieval numbers are not directly
# comparable to pre-sweep runs. Hold it FIXED across the embed_dim sweep — that
# is the comparison that matters. Set BATCH_SIZE=16 to reproduce the old pool.
#
# WALL TIME BASIS: the corpus is ~575k rows (counted off precompute's own rank
# ranges). At 192 ranks x B=32 that is ~94 steps/epoch, ~1965 steps over 21
# epochs, against ~3924 before. Per step is ~2x cheaper (L_p halves and D drops
# 4x, but B and the column count both double), so ~7-8s/step against the ~15s
# the old 16h budget implied => ~4h. 8h holds with room.
BATCH_SIZE=32
GROUP_SIZE=16
PHASE1_EPOCHS=1
PHASE2_EPOCHS=20
LR=2e-4
# R1 token-spread weight; raise toward 0.3 if R1 collapses.
PHASE1_UNIFORMITY_WEIGHT=0.3
# Both off: the R2 contrastive objective carries the geometry on its own at this
# scale. If they are changed, train_hard_negatives.pbs MUST match — "resume with
# its existing objective" silently isn't otherwise.
R2_UNIFORMITY_WEIGHT=0
ALIGN_AUX_WEIGHT=0
# Chunk the FILIP score matrix over the protein axis to cap the transient.
FILIP_CHUNK_ROWS=8
VAL_SUBSET=1000

# ===========================================================================
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "retrieval training (src.train_retrieval)" \
    CACHE_DIR CKPT_DIR \
    BATCH_SIZE GROUP_SIZE PHASE1_EPOCHS PHASE2_EPOCHS LR \
    PHASE1_UNIFORMITY_WEIGHT R2_UNIFORMITY_WEIGHT ALIGN_AUX_WEIGHT \
    FILIP_CHUNK_ROWS VAL_SUBSET

"${MPI_LAUNCH[@]}" \
    python -m src.train_retrieval --use-cache --device xpu \
        --cache-dir "${CACHE_DIR}" --ckpt-dir "${CKPT_DIR}" \
        --batch-size "${BATCH_SIZE}" --group-size "${GROUP_SIZE}" \
        --phase1-epochs "${PHASE1_EPOCHS}" --phase2-epochs "${PHASE2_EPOCHS}" \
        --lr "${LR}" \
        --phase1-uniformity-weight "${PHASE1_UNIFORMITY_WEIGHT}" \
        --r2-uniformity-weight "${R2_UNIFORMITY_WEIGHT}" \
        --align-aux-weight "${ALIGN_AUX_WEIGHT}" \
        --filip-chunk-rows "${FILIP_CHUNK_ROWS}" --val-subset "${VAL_SUBSET}"

finish $?
