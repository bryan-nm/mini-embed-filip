#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_inspect
#PBS -l walltime=00:30:00
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# Per-token FILIP alignment heatmaps for a handful of accessions. Pulls each
# accession's sequence + caption from the corpus, encodes the pair fresh (no
# cache needed), and writes a heatmap per accession to PLOT_DIR.
#
# Single process, on CPU: inspection is light, and CPU avoids any XPU/IPEX setup.
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

# PBS runs this from a spooled copy with $HOME as the working directory, so the
# cd MUST come before the source — see pbs_common.sh.
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./pbs_common.sh
export OMP_NUM_THREADS=32          # single process, so take the whole node

# ===========================================================================
# Checkpoints and I/O
# ===========================================================================
RETRIEVAL_CKPT=checkpoints/retrieval/epoch50.pt
ID_FILE=protein_ids.txt            # one primary_Accession per line
PLOT_DIR=inspect_out               # heatmaps written as <accession>.png

# ===========================================================================
# Hyperparameters
# ===========================================================================
TOP_K=5

# ===========================================================================
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "FILIP alignment heatmaps (src.inspect)" \
    RETRIEVAL_CKPT ID_FILE PLOT_DIR TOP_K
require_files RETRIEVAL_CKPT ID_FILE

mkdir -p "${PLOT_DIR}"
python -m src.inspect --device cpu \
    --ckpt "${RETRIEVAL_CKPT}" \
    --id-file "${ID_FILE}" --top-k "${TOP_K}" --plot-dir "${PLOT_DIR}"
rc=$?

echo "heatmaps in ${PLOT_DIR}/"
finish $rc
