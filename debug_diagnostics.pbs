#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_debug_diag
#PBS -l walltime=01:00:00
#PBS -l select=2
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m abe

module load frameworks
source /flare/NLDesignProtein/bryan/envs/filip-env/bin/activate
cd /flare/NLDesignProtein/bryan/FILIP-dev-space/mini-embed-filip

# ---------------------------------------------------------------------------
# Calibration run for --coverage-lambda / --coverage-tau (SFT) and
# --reward-contrastive / --reward-margin-beta (RL). Four short phases, each
# writing to a scratch dir — nothing here touches a production checkpoint.
#
# WHAT THIS RUN CAN SETTLE (measurement, not search):
#   tau            phase 1 prints the coverage DISTRIBUTION of the trained SFT
#                  model. tau is then read off it, not guessed.
#   lambda         phase 2 gives the covpen-vs-ce magnitude ratio, which fixes
#                  lambda's order of magnitude.
#   length-lambda  phases 3/4 print rstd under both rewards. The contrastive
#                  reward is on a different scale, so the existing
#                  "lambda ~ 4.5*rstd" rule needs the NEW rstd. This is a
#                  required recalibration, not a nice-to-have.
#   smoke          first execution of both new code paths against real models.
#                  The math is unit-tested on synthetic tensors; the integration
#                  is not. Expect this to be what phase 1-2 actually catch.
#
# WHAT IT CANNOT SETTLE:
#   Whether either change IMPROVES anything. Coverage helping multi-clause
#   fidelity, and the margin reward beating the raw one on R@K/mAP, are
#   full-scale questions — a few hundred SFT steps and ~10 RL steps move
#   neither metric out of noise. Use this to pick starting values and to prove
#   the code runs; then A/B at scale.
#
# Usage:
#   qsub -v RCKPT=/path/retrieval/epochNN.pt,SFT_CKPT=/path/generation/text2protein/epochNN.pt \
#        debug_diagnostics.pbs
# Optional: -v PHASES=13 to run only phases 1 and 3, RL_STEPS=..., COV_LAMBDA=...
# ---------------------------------------------------------------------------

: "${RCKPT:?set -v RCKPT=path/to/retrieval/epochNN.pt}"
: "${SFT_CKPT:?set -v SFT_CKPT=path/to/generation/text2protein/epochNN.pt}"

# Default 123: phase 4 (raw-reward control) already ran clean on job 8722544 —
# rstd 0.05-0.12, lenratio median ~1.7, ~49s/step, empty=0/64. Re-run it only to
# re-baseline after a policy change (-v PHASES=1234).
PHASES=${PHASES:-123}
SUBSET=${SUBSET:-2000}         # tiny train subset: these phases measure, not train
VAL_SUBSET=${VAL_SUBSET:-128}
BS=${BS:-32}
CAE=${CAE:-1}
MAX_TGT=${MAX_TGT:-1024}
COV_LAMBDA=${COV_LAMBDA:-0.5}  # phase-2 trial value; phase 1 tells you if it's sane
COV_TAU=${COV_TAU:-0.025}        # phase-1 output replaces this for real runs
# 5 steps is enough for an rstd/margin distribution — job 8722544's rstd bounced
# 0.05-0.12 over 10 steps, so more steps buy spread, not precision. Fewer steps
# also means a stalled phase 3 burns less of the hour before hitting its cap.
RL_STEPS=${RL_STEPS:-5}
MAXNEW=${MAXNEW:-1024}         # keep at production value: rstd scales with it,
PPR=${PPR:-8}                  # and rstd is the number we came here to measure
BETA=${BETA:-1.0}
# Reward-matrix row chunk. If phase 3 stalls again, this is the first knob:
# it trades transient memory (chunk*B*L_gen*L_src floats) against the number
# of sequential einsums. 8 matches the raw path's single-shot footprint.
REW_CHUNK=${REW_CHUNK:-8}

OUT=${OUT:-/flare/NLDesignProtein/bryan/FILIP-dev-space/debug_diag/${PBS_JOBID%%.*}}
mkdir -p "${OUT}"

# train_generation counts epochs ABSOLUTELY, not as "how many more to run", and
# the loop is range(start_epoch, --epochs) with start_epoch = ckpt_epoch + 1.
# So a checkpoint at epoch 6 needs --epochs 8 to run ONE more epoch: 7 is the
# empty range and is rejected. (+1 was the first fix here and it was off by one;
# the old error message said "epoch 6 already at/past --epochs 7", comparing
# start_epoch but printing ckpt_epoch. That message is now fixed too.)
# The epoch must actually complete: the coverage profile prints at the
# END-of-epoch val pass.
RESUME_EPOCH=$(python - "$SFT_CKPT" <<'PY'
import sys, torch
try:
    print(int(torch.load(sys.argv[1], map_location="cpu", weights_only=False)
              .get("epoch", -1)))
except Exception as e:
    print(f"ERR {e}", file=sys.stderr); print(-1)
PY
)
if [ "${RESUME_EPOCH}" -lt 0 ]; then
    echo "FATAL: could not read 'epoch' from ${SFT_CKPT}" >&2
    exit 1
fi
EPOCHS=$(( RESUME_EPOCH + 2 ))
echo "resume checkpoint finished epoch ${RESUME_EPOCH} -> starts at $(( RESUME_EPOCH + 1 )), \
--epochs ${EPOCHS} (exactly one more)"

# --subset-size makes train_generation's build_or_load_splits see the existing
# splits.json as STALE (n mismatch) and rebuild+SAVE a 2000-row split over the
# SHARED cache dir (train_generation.py:850-864, data.py:280-286). Every other
# stage — train_rl, roundtrip_eval, precompute_decoys, export_embeddings — reads
# that same file, so a diagnostic run silently repartitions the real project.
# Job 8722785's RL phase saw 1,829 train rows; job 8723205's saw 518,945 — the
# pool these phases sample from was not stable across runs. Snapshot and restore.
CACHE_DIR=${CACHE_DIR:-/flare/NLDesignProtein/bryan/FILIP-dev-space/mini-embed-filip/cache}
SPLITS="${CACHE_DIR}/splits.json"
if [ -f "${SPLITS}" ]; then
    cp -p "${SPLITS}" "${OUT}/splits.json.bak"
    echo "backed up ${SPLITS} -> ${OUT}/splits.json.bak"
    restore_splits () {
        if [ -f "${OUT}/splits.json.bak" ]; then
            cp -p "${OUT}/splits.json.bak" "${SPLITS}"
            echo "restored ${SPLITS} from backup"
        fi
    }
    trap restore_splits EXIT
else
    echo "WARNING: no ${SPLITS} to back up — check CACHE_DIR if the RL phase's" >&2
    echo "         train-row count looks wrong." >&2
fi

NNODES=$(wc -l < "$PBS_NODEFILE"); RANKS_PER_NODE=12
NRANKS=$(( NNODES * RANKS_PER_NODE ))

export ONEAPI_DEVICE_SELECTOR="level_zero:gpu"
export FILIP_MODELS_DIR=/flare/NLDesignProtein/bryan/FILIP-dev-space/models
export FILIP_PROTEIN_DECODER=${FILIP_MODELS_DIR}/ProtGPT3-112M-dpo
export FILIP_DATA_CSV=/flare/NLDesignProtein/bryan/FILIP-dev-space/datasets/SwissProt_full/fully_annotated_swiss_prot_20260722.csv
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export MASTER_ADDR=$(head -n1 "$PBS_NODEFILE")
export MASTER_PORT=29506
export OMP_NUM_THREADS=8
export CCL_PROCESS_LAUNCHER=pmix
export CCL_ATL_TRANSPORT=mpi
export CCL_KVS_MODE=mpi
export CCL_KVS_CONNECTION_TIMEOUT=600
export FI_PROVIDER=cxi
export CCL_ZE_IPC_EXCHANGE=pidfd

source ~/bin/slack_notify.sh
slack ":microscope: START ${PBS_JOBID} ${PBS_JOBNAME} (${NNODES} nodes, calibration)"

MPI="mpiexec -n ${NRANKS} -ppn ${RANKS_PER_NODE} --pmi=pmix --cpu-bind depth -d 8"
COMMON_SFT="--direction text2protein --retrieval-ckpt ${RCKPT} --device xpu \
    --memory-space aligned --cross-attn-mode aligned --resume ${SFT_CKPT} \
    --batch-size ${BS} --epochs ${EPOCHS} --max-target-tokens ${MAX_TGT} --direction-augment \
    --cross-attn-every ${CAE} --unfreeze-top 0 --no-lora \
    --subset-size ${SUBSET} --val-subset ${VAL_SUBSET} \
    --no-rt-eval --no-rt-at-start"
# --no-rt-eval / --no-rt-at-start: BOTH default ON (train_generation.py
# set_defaults), so every SFT phase was free-running 85 val rows at max_new=1024
# — once before the first epoch and once per epoch. Minutes of generation that
# these phases have no use for: the coverage profile comes from the val CE pass,
# not the round-trip. This is a large share of why phase 1 blew its cap on job
# 8722785. Drop the flags if you ever want R@K out of a diagnostic run.

# Each phase is time-boxed so one slow/hung phase cannot eat the whole job, and
# non-fatal so a later phase still runs if an earlier one dies.
run_phase () {  # run_phase <n> <minutes> <description> <command...>
    local n=$1 mins=$2 desc=$3; shift 3
    case "${PHASES}" in *"${n}"*) ;; *) echo "[phase ${n}] SKIPPED"; return 0 ;; esac
    echo ""
    echo "=================================================================="
    echo "[phase ${n}] ${desc}  (cap ${mins}m)"
    echo "=================================================================="
    timeout "${mins}m" "$@" 2>&1 | tee "${OUT}/phase${n}.log"
    local rc=${PIPESTATUS[0]}
    [ "${rc}" = 124 ] && echo "[phase ${n}] HIT TIME CAP — partial log kept"
    echo "[phase ${n}] exit=${rc}"
    return 0
}

# ---------------------------------------------------------------------------
# PHASE 1 — coverage baseline. --coverage-lambda 0, so this only MEASURES.
# Read [val][cov] in the log:
#   unif       coverage a source position gets from attention that ignores it.
#              Any tau at or below this cannot separate attended from ignored.
#   frac_below the tau ladder. Pick tau where the fraction stops looking like
#              "everything is starved" and starts isolating a real tail — if
#              frac_below(0.05) is already 0.9, the adapter is ignoring almost
#              the whole prompt and the aux has a lot to bite on; if it's 0.02,
#              coverage is NOT your dropped-clause mechanism and phase 2 is
#              the point at which to stop and rethink.
#   p10/p50/p90 the distribution those fractions come from.
# ---------------------------------------------------------------------------
run_phase 1 10 "coverage baseline (measure only, lambda=0)" \
    ${MPI} python -m src.train_generation ${COMMON_SFT} \
    --coverage-lambda 0 --coverage-tau "${COV_TAU}" \
    --ckpt-dir "${OUT}/p1"

# ---------------------------------------------------------------------------
# PHASE 2 — does the aux train, and is lambda scaled right?
# Watch the step log: covpen should FALL and ce should not jump. Size lambda so
# lambda*covpen is a few percent of ce — big enough to move, small enough not to
# trade away the LM. If covpen is already ~0 at the tau from phase 1, the aux has
# nothing to do; if ce climbs steadily, lambda is too high.
# NOTE: no --grad-checkpointing here. The trainer rejects the combination (the
# aux would silently be a no-op under checkpointing), so a big decoder needs the
# aux verified at small BS instead.
# ---------------------------------------------------------------------------
run_phase 2 10 "coverage aux ON (lambda=${COV_LAMBDA} tau=${COV_TAU})" \
    ${MPI} python -m src.train_generation ${COMMON_SFT} \
    --coverage-lambda "${COV_LAMBDA}" --coverage-tau "${COV_TAU}" \
    --ckpt-dir "${OUT}/p2"

# ---------------------------------------------------------------------------
# PHASE 3 — contrastive reward calibration. --log-every 1 so every step prints.
# Read pos / neg / margin / rstd:
#   margin  headroom over the hardest in-batch negative at the SFT init. A margin
#           near zero at step 0 means the SFT policy is already producing hub-ish
#           outputs — which is the case the raw reward cannot see, and the
#           strongest argument for turning this on.
#   rstd    within-group std, the ONLY scale GRPO sees. Feed it to the existing
#           length-lambda rule (~4.5*rstd for a 2x length error = one group-std).
#           It differs from phase 4's rstd; use the one matching the reward you
#           will actually train with.
# Eval off (--eval-every 0) and save-every above the step count: pure measurement.
# ---------------------------------------------------------------------------
run_phase 3 28 "RL contrastive reward (beta=${BETA}, ${RL_STEPS} steps)" \
    ${MPI} python -m src.train_rl --direction text2protein \
    --retrieval-ckpt "${RCKPT}" --init-ckpt "${SFT_CKPT}" --device xpu \
    --steps "${RL_STEPS}" --prompts-per-rank "${PPR}" --group-size 8 \
    --max-new-tokens "${MAXNEW}" --temperature 1.0 --top-p 0.95 \
    --reward-contrastive --reward-margin-beta "${BETA}" \
    --reward-filip-chunk-rows "${REW_CHUNK}" --log-margin-ceiling \
    --length-lambda 0.0 --kl-coef 0.05 --lr 1e-5 --unfreeze-lr 2e-6 \
    --log-every 1 --save-every 100000 --eval-every 0 \
    --ckpt-dir "${OUT}/p3"

# ---------------------------------------------------------------------------
# PHASE 4 — same steps, RAW reward. The rstd comparison against phase 3, and the
# control that says whether the margin term changed the reward landscape at all.
# Same seed and step count, so the two logs are directly comparable line by line.
# ---------------------------------------------------------------------------
run_phase 4 14 "RL raw reward control (${RL_STEPS} steps)" \
    ${MPI} python -m src.train_rl --direction text2protein \
    --retrieval-ckpt "${RCKPT}" --init-ckpt "${SFT_CKPT}" --device xpu \
    --steps "${RL_STEPS}" --prompts-per-rank "${PPR}" --group-size 8 \
    --max-new-tokens "${MAXNEW}" --temperature 1.0 --top-p 0.95 \
    --length-lambda 0.0 --kl-coef 0.05 --lr 1e-5 --unfreeze-lr 2e-6 \
    --log-every 1 --save-every 100000 --eval-every 0 \
    --ckpt-dir "${OUT}/p4"

echo ""
echo "=================================================================="
echo "SUMMARY  (full logs in ${OUT})"
echo "=================================================================="
# NB: `grep ... | sed ... || echo` never fires the fallback — a pipeline's status
# is its LAST command's. Capture first, test the variable.
show_or_none () {  # show_or_none <label> <text>
    if [ -n "$2" ]; then printf '%s\n' "$2"; else echo "  (nothing — phase failed or was skipped)"; fi
}
echo "--- phase 1: coverage distribution (pick --coverage-tau from this) ---"
show_or_none p1 "$(grep -h '\[val\]\[cov\]' "${OUT}/phase1.log" 2>/dev/null)"
echo "--- phase 2: does covpen fall, does ce hold? (first/last step lines) ---"
show_or_none p2 "$(grep -h 'covpen=' "${OUT}/phase2.log" 2>/dev/null | sed -n '1p;$p')"
echo "--- phase 3 vs 4: rstd + margin (size --length-lambda off the right one) ---"
echo "  contrastive:"
show_or_none p3 "$(grep -h '^\[rl\] step=' "${OUT}/phase3.log" 2>/dev/null | tail -3)"
echo "  raw:"
show_or_none p4 "$(grep -h '^\[rl\] step=' "${OUT}/phase4.log" 2>/dev/null | tail -3)"

slack ":white_check_mark: DONE ${PBS_JOBID} ${PBS_JOBNAME} — logs in ${OUT}"
exit 0
