#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_export_emb
#PBS -l walltime=03:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m be

# ---------------------------------------------------------------------------
# LIVE embedding export: run the frozen encoders + trained projection heads over
# a whole corpus that has no precomputed cache. The encoder pass is the expensive
# part, so this is distributed exactly like precompute — every rank takes a shard.
#
# (The CACHED path is single-process and does NOT use this script: just run
#  `python -m src.export_embeddings --ckpt ... --splits ...` on one rank.)
#
# Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

MASTER_PORT=29508
source ./pbs_common.sh

# ===========================================================================
# Checkpoints and I/O
# ===========================================================================
RETRIEVAL_CKPT=checkpoints/retrieval/epoch50.pt
OUT_DIR=embeddings_live
NAME=swissprot         # outputs <OUT_DIR>/<NAME>_pooled.npz

# ===========================================================================
# Hyperparameters
# ===========================================================================
POOLING=mean           # mean = one vector per item; none = full per-token packed
# Encoder batch: keep it equal to precompute.pbs, since this runs the same
# encoders over the same corpus. Attention memory is O(BATCH_SIZE * seqlen^2);
# 128 is the conservative read at the 512-token protein cap (see precompute.pbs).
#
# WALL TIME BASIS: same 4x per-protein saving as precompute, so 3h against the
# old 6h.
BATCH_SIZE=128

# ===========================================================================
slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "live embedding export (src.export_embeddings)" \
    RETRIEVAL_CKPT OUT_DIR NAME POOLING BATCH_SIZE
require_files RETRIEVAL_CKPT

"${MPI_LAUNCH[@]}" \
    python -m src.export_embeddings --live --device xpu \
        --ckpt "${RETRIEVAL_CKPT}" \
        --out-dir "${OUT_DIR}" --name "${NAME}" \
        --pooling "${POOLING}" --batch-size "${BATCH_SIZE}"
rc=$?

echo "embeddings in ${OUT_DIR}/"
finish $rc
