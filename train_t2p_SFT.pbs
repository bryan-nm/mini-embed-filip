#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N filip_t2p_sft
#PBS -l walltime=12:00:00
#PBS -l select=16
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#PBS -M bryan.andrews.phd@gmail.com
#PBS -m abe

# ---------------------------------------------------------------------------
# text -> protein SFT. Split from the old shared train_generation.pbs: the two
# directions no longer want the same regimen (target length, direction
# augmentation, and adapter density all differ), and forcing them through one
# file made every asymmetry look like an accident. See train_p2t_SFT.pbs.
#
# Everything this job depends on is set below and printed to the .o file by
# job_banner. Model and dataset locations are NOT set here — config.py owns them.
# ---------------------------------------------------------------------------

MASTER_PORT=29502
# PBS runs this from a spooled copy with $HOME as the working directory, so the
# cd MUST come before the source — see pbs_common.sh.
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./pbs_common.sh

# ===========================================================================
# Checkpoints
# ===========================================================================
RETRIEVAL_CKPT=checkpoints/retrieval/epoch50.pt
CKPT_DIR=checkpoints/generation            # writes <CKPT_DIR>/text2protein/

# ===========================================================================
# Hyperparameters
# ===========================================================================
# Sizing, tuned for ProtGPT3-112M (hidden 512, 8 layers). The 1.3B decoder is
# ~4x the per-token activation cost (hidden 1024, 17 layers): drop BATCH_SIZE
# and/or set GRAD_CKPT=1 there.
#
# BATCH_SIZE doubled from 32 with the 512-token target cap. At (B=32, T=1024)
# vs (B=64, T=512) the linear term B*T is identical and the attention term B*T^2
# is halved, so this is the same-or-smaller footprint at twice the batch.
#
# WALL TIME BASIS: ~575k rows at 192 ranks x B=64 is ~47 steps/epoch, ~936 steps
# over 20 epochs (against ~1868 before). Per step is same-to-half the old ~31s,
# so ~6-7h of training plus 20 round-trip evals. 12h, not 8 — at ~25s/step this
# is the job with the least margin after p2t, and the eval is not free.
BATCH_SIZE=64
EPOCHS=20
LR=1.5e-4
GRAD_CKPT=0

# Proteins, not captions — but this corpus is filtered to <=500 residues, so 512
# fits every target with nothing truncated and termination is learned across the
# whole length distribution. (An unfiltered SwissProt needs 1024: at 512 it
# truncated ~a quarter of the corpus, and a truncated target carries no EOS.)
# Raise this alongside the corpus if that ever changes.
MAX_TARGET_TOKENS=512
# ProtGPT3 is the only decoder with a C-to-N marker. Each target is factorized
# N-to-C or C-to-N by coin flip, so the C-terminus of a long protein is seen even
# when the N-terminal window is what got cut.
DIRECTION_AUGMENT=1
# Cross-attn on every one of the 8 layers: cheap on a 112M MoE, and it gives the
# conditioning many entry points.
CROSS_ATTN_EVERY=1
CROSS_ATTN_MODE=aligned
MEMORY_SPACE=aligned
UNFREEZE_TOP=2
UNFREEZE_WHERE=top
VAL_SUBSET=100

# Contrastive negative-memory hinge: each step also runs the decoder on a
# shuffled (wrong) memory and penalizes the correct memory unless it beats the
# wrong one by CONTRAST_MARGIN nats/token. Doubles the forward batch to 2B.
CONTRAST_LAMBDA=0.2
CONTRAST_MARGIN=0.5

# Cross-attention coverage aux. Cross-attn softmaxes over the memory axis, so
# each decoder position must spend its mass on the caption, but no caption
# position is required to RECEIVE any — an unattended source token contributes
# ~0 to every attn_out and cannot reach the output at all.
#
# The deficit is MEASURED on this exact config (epoch-6 checkpoint, 39,216 val
# source positions): captions average ~96 valid tokens so uniform attention is
# 0.0104, and the coverage distribution came out p10=0.006 p50=0.026 p90=0.128.
# ~20% of caption positions sit at or below uniform. COV_TAU=0.025 (~2.4x
# uniform) targets that starved lower half; COV_LAMBDA=0.5 puts the penalty at
# ~2% of CE there.
#
# Note what is and is not established: the coverage DEFICIT is measured, the
# BENEFIT is not. Treat the first job under it as the A/B — [gen][rt] gen->src
# R@1/mAP has to hold or improve. If it drops versus the last COV_LAMBDA=0 run
# at the same epoch, set COV_LAMBDA=0. Incompatible with GRAD_CKPT=1.
COV_LAMBDA=0.5
COV_TAU=0.025

# Per-epoch round-trip retrieval eval (free-running; the prefix-free counterpart
# to val CE). The pool is sharded across ranks, so 512 rows is 2-3 rows/rank and
# costs one generate + one N x N FILIP per epoch. RT_MAX_NEW is the real cost
# knob (wall time is linear in it); RT_SAMPLES=0 turns the eval off.
RT_SAMPLES=512
RT_MAX_NEW=${MAX_TARGET_TOKENS}

# ===========================================================================
EXTRA=""
[ "$GRAD_CKPT" = 1 ] && EXTRA="--grad-checkpointing"
[ "$DIRECTION_AUGMENT" = 1 ] && EXTRA="${EXTRA} --direction-augment"
if [ "$RT_SAMPLES" = 0 ]; then
    EXTRA="${EXTRA} --no-rt-eval"
else
    EXTRA="${EXTRA} --rt-samples ${RT_SAMPLES} --rt-max-new-tokens ${RT_MAX_NEW}"
fi

if [ "$GRAD_CKPT" = 1 ] && [ "$COV_LAMBDA" != "0.0" ] && [ "$COV_LAMBDA" != "0" ]; then
    echo "FATAL: COV_LAMBDA>0 cannot be combined with GRAD_CKPT=1 — under" >&2
    echo "       checkpointing the aux reads last_attn from the no_grad pass and" >&2
    echo "       would train as a silent no-op. The trainer rejects this too; this" >&2
    echo "       check just fails before burning the queue slot on model loading." >&2
    exit 1
fi

slack ":rocket: START ${PBS_JOBID} ${PBS_JOBNAME} on ${NNODES} nodes"
job_banner "text2protein SFT (src.train_generation)" \
    RETRIEVAL_CKPT CKPT_DIR \
    BATCH_SIZE EPOCHS LR GRAD_CKPT MAX_TARGET_TOKENS DIRECTION_AUGMENT \
    CROSS_ATTN_EVERY CROSS_ATTN_MODE MEMORY_SPACE UNFREEZE_TOP UNFREEZE_WHERE \
    CONTRAST_LAMBDA CONTRAST_MARGIN COV_LAMBDA COV_TAU \
    RT_SAMPLES RT_MAX_NEW VAL_SUBSET
require_files RETRIEVAL_CKPT

# The per-step log carries trunc=<n>/<batch>: rows whose target overflowed the
# cap and therefore carry NO EOS. It should be ZERO on this corpus — every
# protein is <=500 residues. Anything else means the CSV is not the filtered one.
#
# Per epoch, [gen][rt] reports free-running round-trip retrieval on a fixed val
# pool (R@K/mAP back to the source caption, plus the ceiling from the true
# proteins) and the mean generated vs true body length. That is the metric to
# watch: val CE can fall while gen->src R@1 sits at the floor, which is exactly
# the teacher-forcing confound train_rl.py exists to fix. Full history:
# <CKPT_DIR>/text2protein/sft_roundtrip.jsonl.
"${MPI_LAUNCH[@]}" \
    python -m src.train_generation --direction text2protein --device xpu \
    --retrieval-ckpt "${RETRIEVAL_CKPT}" --ckpt-dir "${CKPT_DIR}" \
    --memory-space "${MEMORY_SPACE}" --cross-attn-mode "${CROSS_ATTN_MODE}" \
    --cross-attn-every "${CROSS_ATTN_EVERY}" \
    --unfreeze-top "${UNFREEZE_TOP}" --unfreeze-where "${UNFREEZE_WHERE}" \
    --batch-size "${BATCH_SIZE}" --epochs "${EPOCHS}" --lr "${LR}" \
    --max-target-tokens "${MAX_TARGET_TOKENS}" \
    --contrast-lambda "${CONTRAST_LAMBDA}" --contrast-margin "${CONTRAST_MARGIN}" \
    --coverage-lambda "${COV_LAMBDA}" --coverage-tau "${COV_TAU}" \
    --val-subset "${VAL_SUBSET}" ${EXTRA}

finish $?
